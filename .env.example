# Copy to .env (and optionally create .env.local for overrides)

# App environment
ENV=local

# HTTP port for local server
PORT=3000

# Log level: debug|info|warn|error
LOG_LEVEL=info

# AWS region for SDK clients (if needed)
AWS_REGION=eu-west-3

# Example DB configuration (uncomment if you add a DB layer)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=app
# DB_PASSWORD=changeme
# DB_NAME=app_local
# DB_SSLMODE=disable

